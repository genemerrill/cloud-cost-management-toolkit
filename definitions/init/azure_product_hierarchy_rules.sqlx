config {
  type: "table",
  name: "azure_product_hierarchy_rules",
  description: "Rules for taxonomy classification of Azure resources (L2 and L3)"
}

SELECT 2 AS hier_level, 10 AS priority, CAST(NULL AS STRING) AS parent_l2, 'Marketplace' AS output_value, '{"field": "publisher_type", "op": "=", "values": ["MARKETPLACE"]}' AS conditions_json UNION ALL
SELECT 2 AS hier_level, 20 AS priority, CAST(NULL AS STRING) AS parent_l2, 'Commitments & Capacity' AS output_value, '{"field": "is_commitment", "op": "IS_TRUE", "values": []}' AS conditions_json UNION ALL
SELECT 2 AS hier_level, 30 AS priority, CAST(NULL AS STRING) AS parent_l2, 'AI' AS output_value, '{"op": "OR", "clauses": [{"field": "consumed_service", "op": "IN", "values": ["MICROSOFT.COGNITIVESERVICES", "MICROSOFT.MACHINELEARNINGSERVICES", "MICROSOFT.BOTSERVICE"]}, {"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["COGNITIVE SERVICES", "OPENAI", "MACHINE LEARNING", "\\\\bAI\\\\b"]}, {"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["NC.*SERIES", "ND.*SERIES", "NV.*SERIES", "GPU"]}]}' AS conditions_json UNION ALL
SELECT 2 AS hier_level, 40 AS priority, CAST(NULL AS STRING) AS parent_l2, 'Compute' AS output_value, '{"op": "OR", "clauses": [{"op": "AND", "clauses": [{"field": "consumed_service", "op": "=", "values": ["MICROSOFT.COMPUTE"]}, {"field": "meter_category", "op": "IN", "values": ["VIRTUAL MACHINES", "AZURE VIRTUAL MACHINES", "VIRTUAL MACHINES LICENSES"]}, {"field": "meter_sub_category", "op": "NOT REGEX_CONTAINS", "values": ["NC.*SERIES", "ND.*SERIES", "NV.*SERIES", "GPU"]}]}, {"field": "consumed_service", "op": "=", "values": ["MICROSOFT.AVS"]}, {"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["VMWARE"]}]}' AS conditions_json UNION ALL
SELECT 2 AS hier_level, 50 AS priority, CAST(NULL AS STRING) AS parent_l2, 'Block Storage' AS output_value, '{"op": "AND", "clauses": [{"field": "consumed_service", "op": "=", "values": ["MICROSOFT.COMPUTE"]}, {"op": "OR", "clauses": [{"field": "meter_category", "op": "IN", "values": ["STORAGE", "MANAGED DISKS"]}, {"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["MANAGED DISK", "SNAPSHOT"]}, {"field": "meter_name", "op": "REGEX_CONTAINS", "values": ["DISK"]}]}]}' AS conditions_json UNION ALL
SELECT 2 AS hier_level, 60 AS priority, CAST(NULL AS STRING) AS parent_l2, 'Security' AS output_value, '{"op": "OR", "clauses": [{"field": "consumed_service", "op": "IN", "values": ["MICROSOFT.KEYVAULT", "MICROSOFT.SECURITY", "MICROSOFT.AAD", "MICROSOFT.ENTRA"]}, {"field": "meter_category", "op": "IN", "values": ["KEY VAULT", "SECURITY CENTER", "AZURE ACTIVE DIRECTORY", "MICROSOFT ENTRA ID", "SENTINEL", "MICROSOFT DEFENDER FOR CLOUD", "AZURE FIREWALL"]}]}' AS conditions_json UNION ALL
SELECT 2 AS hier_level, 70 AS priority, CAST(NULL AS STRING) AS parent_l2, 'Serverless' AS output_value, '{"op": "AND", "clauses": [{"op": "OR", "clauses": [{"field": "consumed_service", "op": "IN", "values": ["MICROSOFT.WEB", "MICROSOFT.CONTAINERINSTANCE", "MICROSOFT.CONTAINERREGISTRY", "MICROSOFT.CONTAINERSERVICE", "MICROSOFT.APP", "MICROSOFT.LOGIC", "MICROSOFT.EVENTGRID", "MICROSOFT.EVENTHUB", "MICROSOFT.SIGNALRSERVICE", "MICROSOFT.SERVICEBUS"]}, {"field": "meter_category", "op": "IN", "values": ["AZURE APP SERVICE", "FUNCTIONS", "CONTAINER INSTANCES", "CONTAINER REGISTRY", "AZURE KUBERNETES SERVICE", "AZURE CONTAINER APPS", "LOGIC APPS", "EVENT GRID", "EVENT HUBS", "SIGNALR"]}]}, {"op": "NOT", "clauses": [{"op": "AND", "clauses": [{"field": "consumed_service", "op": "=", "values": ["MICROSOFT.WEB"]}, {"field": "meter_category", "op": "=", "values": ["BANDWIDTH"]}]}]}]}' AS conditions_json UNION ALL
SELECT 2 AS hier_level, 80 AS priority, CAST(NULL AS STRING) AS parent_l2, 'Storage' AS output_value, '{"op": "AND", "clauses": [{"op": "OR", "clauses": [{"field": "consumed_service", "op": "IN", "values": ["MICROSOFT.STORAGE", "MICROSOFT.DATALAKESTORE", "MICROSOFT.NETAPP", "MICROSOFT.BACKUP", "MICROSOFT.RECOVERYSERVICES"]}, {"field": "meter_category", "op": "IN", "values": ["STORAGE", "AZURE BLOB STORAGE", "AZURE FILES", "AZURE DATA LAKE STORAGE", "AZURE NETAPP FILES", "BACKUP"]}]}, {"op": "NOT", "clauses": [{"op": "AND", "clauses": [{"field": "consumed_service", "op": "=", "values": ["MICROSOFT.STORAGE"]}, {"field": "meter_category", "op": "=", "values": ["BANDWIDTH"]}]}]}, {"field": "meter_category", "op": "NOT REGEX_CONTAINS", "values": ["MONITOR"]}]}' AS conditions_json UNION ALL
SELECT 2 AS hier_level, 90 AS priority, CAST(NULL AS STRING) AS parent_l2, 'Databases' AS output_value, '{"op": "OR", "clauses": [{"field": "consumed_service", "op": "IN", "values": ["MICROSOFT.SQL", "MICROSOFT.DOCUMENTDB", "MICROSOFT.DBFORPOSTGRESQL", "MICROSOFT.DBFORMYSQL", "MICROSOFT.DBFORMARIADB", "MICROSOFT.CACHE", "MICROSOFT.SYNAPSE", "MICROSOFT.FABRIC", "MICROSOFT.DATABRICKS"]}, {"field": "meter_category", "op": "IN", "values": ["SQL DATABASE", "AZURE SQL DATABASE", "SQL MANAGED INSTANCE", "AZURE COSMOS DB", "AZURE DATABASE FOR MYSQL", "AZURE DATABASE FOR POSTGRESQL", "AZURE DATABASE FOR MARIADB", "REDIS CACHE", "AZURE SYNAPSE ANALYTICS", "SYNAPSE ANALYTICS", "MICROSOFT FABRIC", "AZURE DATABRICKS"]}]}' AS conditions_json UNION ALL
SELECT 2 AS hier_level, 100 AS priority, CAST(NULL AS STRING) AS parent_l2, 'Networking' AS output_value, '{"op": "OR", "clauses": [{"field": "consumed_service", "op": "IN", "values": ["MICROSOFT.NETWORK", "MICROSOFT.CDN", "MICROSOFT.FRONTDOOR"]}, {"field": "meter_category", "op": "IN", "values": ["VIRTUAL NETWORK", "BANDWIDTH", "LOAD BALANCER", "VPN GATEWAY", "APPLICATION GATEWAY", "EXPRESSROUTE", "AZURE FRONT DOOR SERVICE", "CONTENT DELIVERY NETWORK"]}, {"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["DATA TRANSFER"]}]}' AS conditions_json UNION ALL

-- L3 Compute
SELECT 3 AS hier_level, 10 AS priority, 'Compute' AS parent_l2, 'Memory Optimized' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["EB.*SERIES", "MB.*SERIES"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 20 AS priority, 'Compute' AS parent_l2, 'General Purpose' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["DADSV5", "DASV5", "DDSV5", "DSV5", "DAV4", "DV4", "D SERIES", "AV2.*SERIES"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 30 AS priority, 'Compute' AS parent_l2, 'Memory Optimized' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["EADSV", "EASV", "EDSV", "ESV", "EAV", "EV.*SERIES", "E SERIES", "M SERIES", "MSV", "MEDIUM MEMORY"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 40 AS priority, 'Compute' AS parent_l2, 'Compute Optimized' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["F.*SERIES"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 50 AS priority, 'Compute' AS parent_l2, 'Storage Optimized' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["L SERIES"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 60 AS priority, 'Compute' AS parent_l2, 'Burstable' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["B.*SERIES", "BURSTABLE"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 70 AS priority, 'Compute' AS parent_l2, 'Basic' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["A SERIES"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 80 AS priority, 'Compute' AS parent_l2, 'Memory and Storage Intensive' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["G SERIES"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 90 AS priority, 'Compute' AS parent_l2, 'HPC' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["HB.*SERIES", "HC.*SERIES"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 100 AS priority, 'Compute' AS parent_l2, 'VMware Solution' AS output_value, '{"op": "OR", "clauses": [{"field": "consumed_service", "op": "=", "values": ["MICROSOFT.AVS"]}, {"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["VMWARE"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 110 AS priority, 'Compute' AS parent_l2, 'Licensing' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["VIRTUAL MACHINES LICENSE"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 1000 AS priority, 'Compute' AS parent_l2, 'General Purpose' AS output_value, '{"op": "ALWAYS_TRUE", "values": []}' AS conditions_json UNION ALL

-- L3 AI
SELECT 3 AS hier_level, 10 AS priority, 'AI' AS parent_l2, 'GPU VM' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["NC.*SERIES", "ND.*SERIES", "NV.*SERIES", "GPU"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 20 AS priority, 'AI' AS parent_l2, 'Foundry Models' AS output_value, '{"field": "meter_category", "op": "=", "values": ["FOUNDRY MODELS"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 30 AS priority, 'AI' AS parent_l2, 'Foundry Tools' AS output_value, '{"field": "meter_category", "op": "=", "values": ["FOUNDRY TOOLS"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 40 AS priority, 'AI' AS parent_l2, 'Cognitive Services' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["COGNITIVE"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 50 AS priority, 'AI' AS parent_l2, 'Machine Learning' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["MACHINE LEARNING"]}' AS conditions_json UNION ALL

-- L3 Storage
SELECT 3 AS hier_level, 10 AS priority, 'Storage' AS parent_l2, 'Blob' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["BLOB"]}, {"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["BLOCK BLOB", "BLOB FEATURES", "CHANGE FEED"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 20 AS priority, 'Storage' AS parent_l2, 'File' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["FILES"]}, {"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["FILES"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 30 AS priority, 'Storage' AS parent_l2, 'Data Lake' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["DATA LAKE"]}, {"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["DATA LAKE", "HIERARCHICAL NAMESPACE"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 40 AS priority, 'Storage' AS parent_l2, 'NetApp Files' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["NETAPP"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 50 AS priority, 'Storage' AS parent_l2, 'Backup' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_category", "op": "=", "values": ["BACKUP"]}, {"field": "consumed_service", "op": "IN", "values": ["MICROSOFT.BACKUP", "MICROSOFT.RECOVERYSERVICES"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 60 AS priority, 'Storage' AS parent_l2, 'Data Transfer' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["BANDWIDTH"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 70 AS priority, 'Storage' AS parent_l2, 'Page' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["PAGE BLOB"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 80 AS priority, 'Storage' AS parent_l2, 'Table' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["TABLES"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 90 AS priority, 'Storage' AS parent_l2, 'Queue' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["QUEUES"]}' AS conditions_json UNION ALL

-- L3 Databases
SELECT 3 AS hier_level, 10 AS priority, 'Databases' AS parent_l2, 'Azure SQL Database' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["SQL DATABASE"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 20 AS priority, 'Databases' AS parent_l2, 'Azure SQL Managed Instance' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["SQL MANAGED INSTANCE"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 30 AS priority, 'Databases' AS parent_l2, 'Azure Synapse Analytics' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["SYNAPSE"]}, {"field": "consumed_service", "op": "=", "values": ["MICROSOFT.SYNAPSE"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 40 AS priority, 'Databases' AS parent_l2, 'Azure Databricks' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["DATABRICKS"]}, {"field": "consumed_service", "op": "=", "values": ["MICROSOFT.DATABRICKS"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 50 AS priority, 'Databases' AS parent_l2, 'Azure Cosmos DB' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["COSMOS"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 60 AS priority, 'Databases' AS parent_l2, 'Azure Database for MySQL' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["MYSQL"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 70 AS priority, 'Databases' AS parent_l2, 'Azure Database for PostgreSQL' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["POSTGRESQL"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 80 AS priority, 'Databases' AS parent_l2, 'Azure Database for MariaDB' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["MARIADB"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 90 AS priority, 'Databases' AS parent_l2, 'Azure Managed Redis' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["REDIS"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 100 AS priority, 'Databases' AS parent_l2, 'Microsoft Fabric' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["FABRIC"]}, {"field": "consumed_service", "op": "=", "values": ["MICROSOFT.FABRIC"]}]}' AS conditions_json UNION ALL

-- L3 Networking
SELECT 3 AS hier_level, 10 AS priority, 'Networking' AS parent_l2, 'Data Transfer' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["DATA TRANSFER"]}, {"field": "meter_category", "op": "=", "values": ["BANDWIDTH"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 20 AS priority, 'Networking' AS parent_l2, 'Load Balancer' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["LOAD BALANCER"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 30 AS priority, 'Networking' AS parent_l2, 'VPN Gateway' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["VPN"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 40 AS priority, 'Networking' AS parent_l2, 'ExpressRoute' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["EXPRESSROUTE"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 50 AS priority, 'Networking' AS parent_l2, 'Front Door' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["FRONT DOOR"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 60 AS priority, 'Networking' AS parent_l2, 'CDN' AS output_value, '{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["CDN", "CONTENT DELIVERY"]}' AS conditions_json UNION ALL

-- L3 Block Storage
SELECT 3 AS hier_level, 10 AS priority, 'Block Storage' AS parent_l2, 'Premium SSD v2' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["PREMIUM SSD V2"]}, {"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["PREMIUM SSD V2"]}, {"field": "meter_name", "op": "REGEX_CONTAINS", "values": ["PREMIUM SSD V2"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 20 AS priority, 'Block Storage' AS parent_l2, 'Premium SSD v3' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["PREMIUM SSD V3"]}, {"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["PREMIUM SSD V3"]}, {"field": "meter_name", "op": "REGEX_CONTAINS", "values": ["PREMIUM SSD V3"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 30 AS priority, 'Block Storage' AS parent_l2, 'Standard SSD v2' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["STANDARD SSD V2"]}, {"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["STANDARD SSD V2"]}, {"field": "meter_name", "op": "REGEX_CONTAINS", "values": ["STANDARD SSD V2"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 40 AS priority, 'Block Storage' AS parent_l2, 'Standard SSD v3' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["STANDARD SSD V3"]}, {"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["STANDARD SSD V3"]}, {"field": "meter_name", "op": "REGEX_CONTAINS", "values": ["STANDARD SSD V3"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 50 AS priority, 'Block Storage' AS parent_l2, 'Ultra Disk v2' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["ULTRA DISK V2", "ULTRA SSD V2"]}, {"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["ULTRA DISK V2", "ULTRA SSD V2"]}, {"field": "meter_name", "op": "REGEX_CONTAINS", "values": ["ULTRA DISK V2", "ULTRA SSD V2"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 60 AS priority, 'Block Storage' AS parent_l2, 'Ultra Disk v3' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["ULTRA DISK V3", "ULTRA SSD V3"]}, {"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["ULTRA DISK V3", "ULTRA SSD V3"]}, {"field": "meter_name", "op": "REGEX_CONTAINS", "values": ["ULTRA DISK V3", "ULTRA SSD V3"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 70 AS priority, 'Block Storage' AS parent_l2, 'Premium SSD' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["PREMIUM SSD"]}, {"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["PREMIUM SSD"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 80 AS priority, 'Block Storage' AS parent_l2, 'Standard SSD' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["STANDARD SSD"]}, {"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["STANDARD SSD"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 90 AS priority, 'Block Storage' AS parent_l2, 'Standard HDD' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["STANDARD HDD", "STANDARD DISK"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 100 AS priority, 'Block Storage' AS parent_l2, 'Ultra Disk' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["ULTRA"]}, {"field": "meter_category", "op": "REGEX_CONTAINS", "values": ["ULTRA"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 110 AS priority, 'Block Storage' AS parent_l2, 'Snapshots' AS output_value, '{"op": "OR", "clauses": [{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["SNAPSHOT"]}, {"field": "meter_name", "op": "REGEX_CONTAINS", "values": ["SNAPSHOT"]}]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 120 AS priority, 'Block Storage' AS parent_l2, 'Page Blob' AS output_value, '{"field": "meter_sub_category", "op": "REGEX_CONTAINS", "values": ["PAGE BLOB"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 1000 AS priority, 'Block Storage' AS parent_l2, 'Managed Disks' AS output_value, '{"op": "ALWAYS_TRUE", "values": []}' AS conditions_json UNION ALL

-- L3 Commitments
SELECT 3 AS hier_level, 10 AS priority, 'Commitments & Capacity' AS parent_l2, 'Reservation' AS output_value, '{"field": "pricing_model", "op": "=", "values": ["RESERVATION"]}' AS conditions_json UNION ALL
SELECT 3 AS hier_level, 20 AS priority, 'Commitments & Capacity' AS parent_l2, 'Savings Plan' AS output_value, '{"field": "pricing_model", "op": "=", "values": ["SAVINGSPLAN"]}' AS conditions_json UNION ALL

-- L3 Others
SELECT 3 AS hier_level, 10 AS priority, 'Others' AS parent_l2, 'Observability' AS output_value, '{"field": "meter_category", "op": "IN", "values": ["AZURE MONITOR", "LOG ANALYTICS", "INSIGHT AND ANALYTICS"]}' AS conditions_json
