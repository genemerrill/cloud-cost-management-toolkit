  ('us-east5', 'Ohio', 'Country subdivision (1st level)'),
  ('us-south1', 'Texas', 'Country subdivision (1st level)'),
  ('us-west1', 'Oregon', 'Country subdivision (1st level)'),
  ('us-west2', 'California', 'Country subdivision (1st level)'),
  ('us-west3', 'Utah', 'Country subdivision (1st level)'),
  ('us-west4', 'Nevada', 'Country subdivision (1st level)')
]);


CREATE TABLE IF NOT EXISTS ${ref("azure_product_hierarchy_rules")} 
(
  rule_id STRING OPTIONS(description="Unique ID for the rule"),
  hier_level INT64 OPTIONS(description="Hierarchy level (1 to n)"),
  priority INT64 OPTIONS(description="Evaluation order, lower means higher priority"),
  output_value STRING OPTIONS(description="The category value to assign if the rule matches"),
  parent_l2 STRING OPTIONS(description="Required L2 value for this rule to be considered (for L3+)"),
  parent_l3 STRING OPTIONS(description="Required L3 value (for L4+)"),
  parent_l4 STRING,
  parent_l5 STRING,
  parent_l6 STRING,
  parent_l7 STRING,
  conditions_json STRING OPTIONS(description="JSON string representing the matching conditions"),
  description STRING OPTIONS(description="Optional description of the rule")
)
AS
SELECT * FROM UNNEST([
  STRUCT<rule_id STRING, hier_level INT64, priority INT64, output_value STRING, parent_l2 STRING, parent_l3 STRING, parent_l4 STRING, parent_l5 STRING, parent_l6 STRING, parent_l7 STRING, conditions_json STRING, description STRING>
  -- LVL 2 Examples
  ('L2_001', 2, 10, 'Marketplace', NULL, NULL, NULL, NULL, NULL, NULL, '{"field": "publisher_type", "op": "=", "values": ["MARKETPLACE"]}', 'Marketplace'),
  ('L2_002', 2, 20, 'Commitments & Capacity', NULL, NULL, NULL, NULL, NULL, NULL, '{"field": "is_commitment", "op": "IS_TRUE"}', 'Commitments'),
  ('L2_003', 2, 30, 'AI', NULL, NULL, NULL, NULL, NULL, NULL, '''{"op": "OR", "clauses": [
      {"field": "consumed_service", "op": "IN", "values": ["MICROSOFT.COGNITIVESERVICES", "MICROSOFT.MACHINELEARNINGSERVICES", "MICROSOFT.BOTSERVICE"]},
      {"field": "meter_category", "op": "LIKE", "values": ["%COGNITIVE SERVICES%", "%OPENAI%", "%MACHINE LEARNING%", "% AI %", "AI %", "% AI"]},
      {"field": "meter_sub_category", "op": "LIKE", "values": ["%NC%SERIES%", "%ND%SERIES%", "%NV%SERIES%", "%GPU%"]}
    ]}''', 'AI Services & Hardware'),
  ('L2_004', 2, 40, 'Compute', NULL, NULL, NULL, NULL, NULL, NULL, '''{"op": "OR", "clauses": [
      {"op": "AND", "clauses": [
        {"field": "consumed_service", "op": "=", "values": ["MICROSOFT.COMPUTE"]},
        {"field": "meter_category", "op": "IN", "values": ["VIRTUAL MACHINES", "AZURE VIRTUAL MACHINES", "VIRTUAL MACHINES LICENSES"]},
        {"field": "meter_sub_category", "op": "NOT LIKE", "values": ["%NC%SERIES%", "%ND%SERIES%", "%NV%SERIES%", "%GPU%"]}
      ]},
      {"field": "consumed_service", "op": "=", "values": ["MICROSOFT.AVS"]},
      {"field": "meter_category", "op": "LIKE", "values": ["%VMWARE%"]}
    ]}''', 'Compute VMs & VMware'),
  -- ... all other L2 rules ...
  ('L2_999', 2, 9990, 'Others', NULL, NULL, NULL, NULL, NULL, NULL, '{"op": "ALWAYS_TRUE"}', 'L2 Default'),

  -- LVL 3 Examples
  ('L3_COMP_001', 3, 10, 'Memory Optimized', 'Compute', NULL, NULL, NULL, NULL, NULL, '{"field": "meter_sub_category", "op": "LIKE", "values": ["%EB%SERIES%", "%MB%SERIES%"]}', 'Compute - Memory Optimized'),
  ('L3_COMP_002', 3, 20, 'General Purpose', 'Compute', NULL, NULL, NULL, NULL, NULL, '{"field": "meter_sub_category", "op": "LIKE", "values": ["%DADSV5%", "%DASV5%", "%DDSV5%", "%DSV5%", "%DAV4%", "%DV4%", "%D SERIES%", "%AV2%SERIES%"]}', 'Compute - General Purpose'),
  -- ... all other L3 rules for Compute ...
  ('L3_COMP_999', 3, 9990, 'General Purpose', 'Compute', NULL, NULL, NULL, NULL, NULL, '{"op": "ALWAYS_TRUE"}', 'Compute - L3 Default'),

  ('L3_AI_001', 3, 10, 'GPU VM', 'AI', NULL, NULL, NULL, NULL, NULL, '{"field": "meter_sub_category", "op": "LIKE", "values": ["%NC%SERIES%", "%ND%SERIES%", "%NV%SERIES%"]}', 'AI - GPU VM'),
  -- ... all other L3 rules for AI ...
  ('L3_AI_999', 3, 9990, 'Other AI', 'AI', NULL, NULL, NULL, NULL, NULL, '{"op": "ALWAYS_TRUE"}', 'AI - L3 Default')

  -- ... You would need to add ALL the default rules for levels 2 through n here ...
])
;

    