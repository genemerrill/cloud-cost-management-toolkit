CREATE OR REPLACE FUNCTION ${dataform.projectConfig.vars.udfs_dataset}.EvaluateRule(
  data STRUCT<
    meter_category STRING, meter_sub_category STRING, meter_name STRING, meter_region STRING,
    consumed_service STRING, publisher_name STRING, tag__deployment STRING, plan_name STRING,
    unit_of_measure STRING, publisher_type STRING, pricing_model STRING, term STRING, is_commitment INT64
  >,
  conditions_json STRING)
RETURNS BOOL
LANGUAGE js AS """
  function evaluateCondition(clause, data) {
    const field = clause.field;
    const op = clause.op;
    const values = clause.values;

    if (clause.op === 'ALWAYS_TRUE') return true;

    if (!data || data[field] === undefined) {
       // Handle cases where data or field is missing
       return op === 'IS_NULL';
    }
    const rawValue = data[field];

    if (rawValue === null) {
       if (op === 'IS_NULL') return true;
       if (op === 'IS_NOT_NULL') return false;
       return false; // Other ops on NULL are false
    }
    let actualValue = typeof rawValue === 'string' ? rawValue.toUpperCase() : rawValue;

    const upperValues = Array.isArray(values) ? values.map(v => typeof v === 'string' ? v.toUpperCase() : v) : [];

    switch (op) {
      case 'IN':
        return upperValues.includes(actualValue);
      case 'NOT IN':
        return !upperValues.includes(actualValue);
      case '=':
        return actualValue === upperValues[0];
      case '<>':
      case '!=':
        return actualValue !== upperValues[0];
      case 'LIKE':
        return upperValues.some(val => actualValue.includes(val));
      case 'NOT LIKE':
        return !upperValues.some(val => actualValue.includes(val));
      case 'REGEX_CONTAINS':
        return upperValues.some(val => {
          try {
            const regex = new RegExp(val, 'i');
            return regex.test(data[field]);
          } catch (e) { return false; }
        });
      case 'NOT REGEX_CONTAINS':
         return !upperValues.some(val => {
          try {
            const regex = new RegExp(val, 'i');
            return regex.test(data[field]);
          } catch (e) { return false; }
        });
      case 'IS_TRUE': // For is_commitment
        return actualValue === 1;
      case 'IS_FALSE':
        return actualValue === 0;
      case 'IS_NULL':
         return false; // Handled above
      case 'IS_NOT_NULL':
         return true; // Handled above
      default:
        return false;
    }
  }

  function evaluateClause(clause, data) {
    if (!clause || !clause.op) return false; // Basic validation
    if (clause.op === 'AND') {
      return Array.isArray(clause.clauses) && clause.clauses.every(c => evaluateClause(c, data));
    } else if (clause.op === 'OR') {
      return Array.isArray(clause.clauses) && clause.clauses.some(c => evaluateClause(c, data));
    } else {
      return evaluateCondition(clause, data);
    }
  }

  try {
    if (!conditions_json) return false;
    const conditions = JSON.parse(conditions_json);
    return evaluateClause(conditions, data);
  } catch (e) {
    // Optional: Log error, but UDFs can't have side effects like console.log visible outside.
    // Consider returning a specific error code if you need to debug from SQL.
    return false; // Error in JSON or evaluation
  }
""";
